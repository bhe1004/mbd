\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Nonholonomic unicycle parking (start $\bullet $, goal $\star $; deep Koopman, representative run). Ours (bilinear, left) reaches the goal pose, matching the true-dynamics oracle (centre); MPPI-DK (linear, right) drives off and never converges, since a constant input matrix cannot represent the heading-dependent coupling $v(\cos \theta ,\sin \theta )$ (parking rates over $20$ trials: $95/85/0\%$, Sec.~\ref {sec:exp}).}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:unicycle}{{2}{4}{Nonholonomic unicycle parking (start $\bullet $, goal $\star $; deep Koopman, representative run). Ours (bilinear, left) reaches the goal pose, matching the true-dynamics oracle (centre); MPPI-DK (linear, right) drives off and never converges, since a constant input matrix cannot represent the heading-dependent coupling $v(\cos \theta ,\sin \theta )$ (parking rates over $20$ trials: $95/85/0\%$, Sec.~\ref {sec:exp})}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 7-DOF manipulator end-effector reach (goal $\star $). Ours (bilinear, left) and the oracle (centre) reach the target; MPPI-DK (linear, right) stalls far away, as a constant input matrix cannot represent the configuration-dependent Jacobian $J(q)$.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:arm}{{3}{4}{7-DOF manipulator end-effector reach (goal $\star $). Ours (bilinear, left) and the oracle (centre) reach the target; MPPI-DK (linear, right) stalls far away, as a constant input matrix cannot represent the configuration-dependent Jacobian $J(q)$}{figure.3}{}}
