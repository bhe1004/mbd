\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Final FR3 configuration (bold kinematic chain) and TCP path (dotted) on the seventh reach target for each method. \textsc  {BK-MBD}{}, the oracle, and \textsc  {DK-MBD-split}{} bring the tool to the target ($\star $) in $19$--$26$ steps; \textsc  {DK-MBD}{} leaves the arm short of the goal at the step limit ($6.9$\,cm).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:franka_pose}{{2}{6}{Final FR3 configuration (bold kinematic chain) and TCP path (dotted) on the seventh reach target for each method. \bkmbd {}, the oracle, and \dksplit {} bring the tool to the target ($\star $) in $19$--$26$ steps; \dkmbd {} leaves the arm short of the goal at the step limit ($6.9$\,cm)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Executed closed-loop FR3 motions on a representative reach, rendered as afterimages (translucent snapshots along the trajectory). \textsc  {BK-MBD}{} (left) sweeps directly to the target (green sphere; TCP trace in red), whereas \textsc  {DK-MBD}{} (right) wanders across the workspace without settling on the target (blue trace).}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:franka_ghost}{{3}{6}{Executed closed-loop FR3 motions on a representative reach, rendered as afterimages (translucent snapshots along the trajectory). \bkmbd {} (left) sweeps directly to the target (green sphere; TCP trace in red), whereas \dkmbd {} (right) wanders across the workspace without settling on the target (blue trace)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Open-loop prediction error vs.\ horizon for the trained FR3 checkpoints used in closed loop (mean $\pm $ std over five seeds, held-out data, log scale). The classes coincide on the joint rows (dashed); on the TCP rows (solid) the linear model is only $1.33\times $ worse at the planning horizon $H = 15$---yet reaches the strict tolerance in only $7/35$ closed-loop trials against $35/35$ for the bilinear model.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:pred_horizon}{{4}{6}{Open-loop prediction error vs.\ horizon for the trained FR3 checkpoints used in closed loop (mean $\pm $ std over five seeds, held-out data, log scale). The classes coincide on the joint rows (dashed); on the TCP rows (solid) the linear model is only $1.33\times $ worse at the planning horizon $H = 15$---yet reaches the strict tolerance in only $7/35$ closed-loop trials against $35/35$ for the bilinear model}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Optimizer ablation on the kinematic arm: identical bilinear checkpoints, cost, and tube; only the update schedule varies ($5$ seeds $\times $ $7$ targets). (a) is the MPPI operating point; (d) is the full anneal used by \textsc  {BK-MBD}{}.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:anneal}{{V}{6}{Optimizer ablation on the kinematic arm: identical bilinear checkpoints, cost, and tube; only the update schedule varies ($5$ seeds $\times $ $7$ targets). (a) is the MPPI operating point; (d) is the full anneal used by \bkmbd {}}{table.5}{}}
